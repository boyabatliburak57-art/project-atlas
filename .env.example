# Local Docker Compose infrastructure
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=replace-with-a-local-password

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Application connection examples
DATABASE_URL=postgresql://atlas:replace-with-a-local-password@127.0.0.1:5432/atlas
TEST_DATABASE_URL=postgresql://atlas:replace-with-a-local-password@127.0.0.1:5432/atlas_test
REDIS_URL=redis://127.0.0.1:6379
MARKET_DATA_PROVIDER_MODE=disabled
EMAIL_PROVIDER_MODE=sandbox
EMAIL_PROVIDER_BASE_URL=https://email-sandbox.example
EMAIL_PROVIDER_CREDENTIAL_REF=secret://atlas/email-provider
EMAIL_PROVIDER_TOKEN=${ATLAS_EMAIL_PROVIDER_TOKEN_FROM_SECRET_MANAGER}
EMAIL_PROVIDER_KEY=transactional-email
EMAIL_WEBHOOK_SIGNING_SECRET=${ATLAS_EMAIL_WEBHOOK_SIGNING_SECRET_FROM_SECRET_MANAGER}
# Set only after a provider is selected and its licensed adapter is registered.
MARKET_DATA_PROVIDER_CODE=
MARKET_DATA_PROVIDER_BASE_URL=
MARKET_DATA_PROVIDER_CREDENTIAL_REF=
MARKET_DATA_PROVIDER_LICENSE_ID=
MARKET_DATA_PROVIDER=
BORSA_API_ENABLED=false
BORSA_API_TIMEOUT_MS=10000
BORSA_API_MAX_CONCURRENCY=2
BORSA_API_REQUESTS_PER_SECOND=1
BORSA_API_ALLOW_IN_PRODUCTION=false
RUN_LIVE_BORSA_API_TESTS=false

# Web application public configuration (never put secrets in NEXT_PUBLIC_* variables)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# API application
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=log
SCANNER_PROGRESS_POLL_AFTER_MS=1000
SCANNER_PROGRESS_STALE_AFTER_MS=15000

# Worker application
WORKER_CONCURRENCY=2
WORKER_HEARTBEAT_INTERVAL_MS=30000
WORKER_LOG_LEVEL=info
WORKER_STARTUP_TIMEOUT_MS=10000
SCANNER_BATCH_SIZE=100
SCANNER_BATCH_TIMEOUT_MS=30000
SCANNER_RUN_TIMEOUT_MS=300000
BACKTEST_EVENT_BATCH_SIZE=250
BACKTEST_RUN_TIMEOUT_MS=600000

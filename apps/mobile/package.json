{
  "name": "@atlas/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "EXPO_PUBLIC_API_BASE_URL=https://api.invalid.example/api/v1 EXPO_PUBLIC_APP_ENV=production expo export --platform all --output-dir dist",
    "build:local": "expo export --platform all --output-dir dist",
    "config:check": "tsx scripts/validate-config.ts",
    "doctor": "expo-doctor",
    "ios": "expo run:ios",
    "release:ios": "EXPO_PUBLIC_API_BASE_URL=https://api.invalid.example/api/v1 EXPO_PUBLIC_APP_ENV=production expo export --platform ios --output-dir dist-ios",
    "lint": "eslint app src scripts app.config.ts",
    "prebuild:check": "expo config --type public",
    "start": "expo start",
    "test": "vitest run --exclude 'src/**/*.integration.test.ts'",
    "test:e2e": "tsx scripts/e2e-smoke.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "visual:report": "node scripts/visual-regression.mjs --report",
    "visual:test": "node scripts/visual-regression.mjs",
    "visual:update": "node scripts/visual-regression.mjs --update",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atlas/api-client": "workspace:*",
    "@atlas/design-tokens": "workspace:*",
    "@atlas/domain": "workspace:*",
    "@atlas/financial-formatting": "workspace:*",
    "@atlas/mobile-ui": "workspace:*",
    "@atlas/telemetry": "workspace:*",
    "@atlas/types": "workspace:*",
    "@atlas/validation": "workspace:*",
    "@expo/metro-runtime": "~57.0.10",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.101.4",
    "expo": "~57.0.13",
    "expo-application": "~57.0.2",
    "expo-constants": "~57.0.11",
    "expo-crypto": "~57.0.1",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.4",
    "expo-linking": "~57.0.6",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "7.83.0",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@react-native/metro-config": "0.86.2",
    "@testing-library/react-native": "14.0.1",
    "@types/node": "26.1.1",
    "@types/react": "~19.2.2",
    "expo-doctor": "1.20.1",
    "react-test-renderer": "19.2.3",
    "tsx": "4.23.0",
    "vitest": "4.1.10"
  }
}
